---
import SiteLayout from '../layouts/SiteLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/posts';
import { profile, socials } from '../data/site';
const posts = (await getPosts()).slice(0, 3);
const person = { '@context': 'https://schema.org', '@type': 'Person', name: 'Mishal Abdullah', url: Astro.site, image: new URL(profile.hero.image, Astro.site), jobTitle: 'Software Engineer', sameAs: socials.map(s => s.url) };
---
<SiteLayout title="Mishal Abdullah — Developer, Indie Hacker & Writer" description="I’m Mishal Abdullah, a developer and indie hacker building AI products and open networks. Explore my projects, open-source work, and articles on technology and intentional living.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, '\\u003c')} />
  <section class="container hero">
    <div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> DEVELOPER · INDIE HACKER · WRITER</p><h1>Hey, I’m Mishal<span class="accent">.</span><br />I build things.<br /><span class="muted-heading">And share the journey.</span></h1><p class="hero-description">A programmer with a curious mind and a love for making things work. I build AI products, contribute to open source, and write about what I learn along the way.</p><div class="actions"><a class="button" href="/blogs/">Explore my writing <span>↗</span></a><a class="text-link" href="/about/">A little about me →</a></div><div class="hero-socials">FIND ME ON {socials.map(s => <a href={s.url}>{s.name === 'X / Twitter' ? 'X' : s.name} ↗</a>)}</div></div>
    <div class="hero-portrait"><div class="portrait-frame"><img src={profile.hero.image} alt="Mishal Abdullah at a Beckn community event" width="700" height="850" fetchpriority="high" /><span class="portrait-caption">Curiosity is the starting point.</span></div><span class="portrait-note">always building something ↗</span><div class="portrait-sticker"><span>⌘</span> Built on<br /><strong>curiosity.</strong></div></div>
  </section>
  <div class="container community-strip"><span>BUILDING & CONTRIBUTING WITH</span><div><a href="https://github.com/beckn">beckn</a><a href="https://mulearn.org">μLearn</a><a href="https://github.com/Portkey-AI/gateway">Portkey</a><a href="https://fsci.in">FSCI</a><a href="https://kerala.openstreetmap.in/">OpenStreetMap</a></div></div>
  <section class="container section"><div class="section-heading"><div><p class="eyebrow">THE DIGITAL NOTEBOOK</p><h2>A few things worth sharing<span class="accent">.</span></h2></div><a class="text-link" href="/blogs/">All articles ↗</a></div><p class="section-intro">Practical guides, useful discoveries, and thoughts on a more intentional life.</p><div class="post-grid">{posts.map(post => <PostCard post={post} />)}</div></section>
  <section class="band"><div class="container section"><div class="section-heading"><div><p class="eyebrow">FROM IDEA TO SOMETHING REAL</p><h2>Things I’ve been building<span class="accent">.</span></h2></div><a class="text-link" href="/projects/">Explore projects ↗</a></div><div class="project-grid">{profile.projects.items.slice(0, 2).map((p: any) => <a class="project-card" href={p.featured.link}><div class="project-image"><img src={p.image} alt={`${p.title} application`} width="700" height="430" loading="lazy" /></div><div class="project-details"><div><h3>{p.title}</h3><p>{p.content}</p></div><span>↗</span></div></a>)}</div></div></section>
  <section class="container section about-preview"><img src={profile.about.image} alt="Mishal Abdullah at a community gathering" width="600" height="650" loading="lazy" /><div><p class="eyebrow">A HUMAN BEHIND THE CODE</p><h2>Curious by nature.<br />A builder at heart.</h2><p>I’m drawn to the things that make you ask, “what if?” Highly niche tools. Unfamiliar tech stacks. Open networks that bring people together.</p><p>From hacking on AI products to leading the Beckn Kerala chapter, I love learning by doing — and helping others do the same.</p><a class="text-link" href="/about/">Read my story ↗</a></div></section>
  <section class="container section"><div class="section-heading"><div><p class="eyebrow">LEARNING, OUT LOUD</p><h2>On the other side of the screen<span class="accent">.</span></h2></div><a class="text-link" href={profile.youtubeVideos.channelUrl}>My YouTube channel ↗</a></div><a class="video-feature" href={profile.featuredByCreators.videoUrl}><img src={profile.featuredByCreators.thumbnailUrl} alt="Creator feature featuring Mishal" width="480" height="360" loading="lazy" /><div><p class="eyebrow">FEATURED BY CREATORS</p><h3>A small moment.<br />A bigger conversation.</h3><p>{profile.featuredByCreators.label}</p><span class="text-link">Watch the feature ↗</span></div><span class="play" aria-hidden="true">▶</span></a></section>
  <section class="container connect-panel"><p class="eyebrow">GOOD THINGS START WITH A CONVERSATION</p><h2>Have something in mind?<br />Let’s build on it<span class="accent">.</span></h2><a class="button" href="/contact/">Say hello ↗</a><a class="text-link" href="/rss.xml">Or follow the writing via RSS →</a></section>
</SiteLayout>
