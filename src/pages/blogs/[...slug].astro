---
import { render } from 'astro:content';
import { getPosts, postUrl } from '../../lib/posts';
import BlogPost from '../../layouts/BlogPost.astro';
export async function getStaticPaths() { return (await getPosts()).map(post => ({ params: { slug: post.id }, props: { post } })); }
const { post } = Astro.props;
if (post.data.URL) return Astro.redirect(postUrl(post), 301);
const { Content, headings } = await render(post);
---
<BlogPost post={post} headings={headings}><Content /></BlogPost>
