---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';
const posts = await getPosts();
const tags = [...new Set(posts.flatMap(p => p.data.tags))].sort();
---
<SiteLayout title="Articles & guides" description="Practical articles by Mishal Abdullah on software development, self-hosting, open-source tools, productivity, and intentional living."><section class="container page-heading"><p class="eyebrow">THE DIGITAL NOTEBOOK</p><h1>Learn something.<br />Make something<span class="accent">.</span></h1><p>Notes from the journey — on technology, tools, and living a little more intentionally.</p></section><section class="container section blog-library"><div class="search-bar"><label for="search">Search articles</label><input id="search" type="search" placeholder="Find an idea, a tool, a guide…" /><label for="topic">Topic</label><select id="topic"><option value="">All topics</option>{tags.map(t => <option>{t}</option>)}</select></div><p id="result-count" class="meta" aria-live="polite">{posts.length} articles</p><div class="post-grid">{posts.map(post => <PostCard post={post} />)}</div><p id="empty-results" hidden>No articles found. Try another search or topic.</p></section></SiteLayout>
<script>
const search = document.querySelector<HTMLInputElement>('#search')!;
const topic = document.querySelector<HTMLSelectElement>('#topic')!;
const cards = [...document.querySelectorAll<HTMLElement>('[data-search]')];
function filter() { let count = 0; for (const card of cards) { const visible = card.dataset.search!.includes(search.value.trim().toLowerCase()) && (!topic.value || JSON.parse(card.dataset.tags!).includes(topic.value)); card.hidden = !visible; if (visible) count++; } document.querySelector('#result-count')!.textContent = `${count} article${count === 1 ? '' : 's'}`; (document.querySelector('#empty-results') as HTMLElement).hidden = count > 0; }
search.addEventListener('input', filter); topic.addEventListener('change', filter);
</script>
