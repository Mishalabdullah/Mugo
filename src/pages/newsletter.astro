---
import BaseHead from '../components/BaseHead.astro';

const options = JSON.stringify({
  settings: {
    after_subscribe: {
      action: 'message',
      success_message: 'Success! Now check your email to confirm your subscription.',
      redirect_url: '',
    },
    powered_by: { show: true },
    recaptcha: { enabled: false },
    return_visitor: { action: 'show', custom_content: '' },
  },
  version: '5',
});
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="The monthly newsletter" description="A personally handcrafted monthly letter from Mishal Abdullah: what I’m building, interesting tools, and things worth sharing." />
  </head>
  <body>
    <div class="newsletter-page">
      <header>
        <a class="wordmark" href="/" aria-label="Mishal Abdullah home">mishal<span>.</span></a>
        <a class="back-link" href="/">Back to home <span aria-hidden="true">↗</span></a>
      </header>

      <main id="main">
        <section aria-labelledby="newsletter-title">
          <p class="eyebrow"><span class="status-dot"></span>ONE LETTER. EVERY MONTH.</p>
          <h1 id="newsletter-title">A little less noise.<br />A few good <span class="accent">finds.</span></h1>
          <p class="intro">What I’m building, tools I find interesting, and the things worth passing on. Personally picked and handcrafted by me, for your inbox.</p>

          <ul class="topics" aria-label="What’s inside">
            <li><span aria-hidden="true">↗</span> Things I’m building</li>
            <li><span aria-hidden="true">✳</span> Tools worth trying</li>
            <li><span aria-hidden="true">✎</span> Notes along the way</li>
          </ul>

          <div class="signup">
            <form
              action="https://app.kit.com/forms/10225892/subscriptions"
              class="seva-form formkit-form"
              method="post"
              data-sv-form="10225892"
              data-uid="80b75bd7f4"
              data-format="inline"
              data-version="5"
              data-options={options}
            >
              <div data-style="clean">
                <ul class="formkit-alert formkit-alert-error" data-element="errors" data-group="alert" aria-live="polite"></ul>
                <div data-element="fields" data-stacked="false" class="seva-fields formkit-fields">
                  <div class="formkit-field">
                    <label class="email-label" for="newsletter-email">Your email address</label>
                    <input id="newsletter-email" class="formkit-input" name="email_address" placeholder="you@example.com" autocomplete="email" required type="email" />
                  </div>
                  <button data-element="submit" class="formkit-submit" type="submit">
                    <div class="formkit-spinner" aria-hidden="true"><div></div><div></div><div></div></div>
                    <span>Count me in <span aria-hidden="true">↗</span></span>
                  </button>
                </div>
                <div class="formkit-powered-by-convertkit-container">
                  <a href="https://kit.com/features/forms?utm_campaign=poweredby&amp;utm_content=form&amp;utm_medium=referral&amp;utm_source=dynamic" data-element="powered-by" class="formkit-powered-by-convertkit" target="_blank" rel="nofollow noopener">Built with Kit ↗</a>
                </div>
              </div>
            </form>
            <p class="fine-print">Free to read. Once a month. Unsubscribe anytime.</p>
          </div>
          <p class="signature">See you in your inbox,<br /><strong>Mishal</strong></p>
        </section>
      </main>

      <footer><span>A small letter from a curious builder.</span><span>Written by a human. Always.</span></footer>
    </div>
    <script is:inline src="https://f.convertkit.com/ckjs/ck.5.js" defer></script>
  </body>
</html>

<style>
  .newsletter-page { min-height: 100svh; width: min(1180px, calc(100% - 80px)); margin-inline: auto; display: flex; flex-direction: column; }
  header { display: flex; justify-content: space-between; align-items: center; padding-block: 26px; }
  .back-link { color: var(--muted); font-size: .8rem; }
  .back-link span { margin-left: 14px; color: var(--accent); }
  main { flex: 1; display: grid; align-items: center; padding: 24px 0; }
  section { width: min(100%, 700px); margin-inline: auto; }
  .eyebrow { margin-bottom: 20px; }
  h1 { font-size: clamp(2.5rem, 5.6vw, 4.4rem); margin-bottom: 22px; line-height: 1.08; }
  .intro { max-width: 560px; font-size: .98rem; line-height: 1.8; margin-bottom: 24px; }
  .topics { display: flex; flex-wrap: wrap; gap: 10px 24px; list-style: none; padding: 0; margin: 0 0 30px; font-size: .75rem; color: var(--muted); }
  .topics li span { color: var(--accent); margin-right: 7px; }
  .signup { max-width: 560px; }
  .formkit-fields { display: flex; gap: 10px; align-items: end; }
  .formkit-field { flex: 1; min-width: 0; }
  .email-label { display: block; font-size: .75rem; margin-bottom: 7px; }
  .formkit-input { width: 100%; min-width: 0; height: 52px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); color: var(--text); padding: 0 16px; font-size: 16px; }
  .formkit-input::placeholder { color: var(--muted); }
  .formkit-submit { height: 52px; border: 0; border-radius: 6px; background: var(--accent); color: var(--bg); padding: 0 23px; font-size: .85rem; font-weight: 600; position: relative; white-space: nowrap; }
  .formkit-submit > span > span { margin-left: 18px; }
  .formkit-submit:hover { background: #b5daff; }
  a:focus-visible, input:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .formkit-powered-by-convertkit-container { margin-top: 8px; text-align: right; font-size: .65rem; color: var(--muted); }
  .fine-print { font-size: .7rem; margin: 6px 0 0; }
  .signature { margin: 22px 0 0; font-size: .8rem; line-height: 1.7; }
  .signature strong { color: var(--text); font-weight: 500; }
  footer { padding-block: 18px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 12px; color: var(--muted); font-size: .65rem; }
  .formkit-alert:empty { display: none; }
  .formkit-alert { list-style: none; padding: 10px 14px; margin: 0 0 12px; border: 1px solid #f2643b; border-radius: 6px; color: #ffb29d; font-size: .8rem; }
  .signup :global(.formkit-alert-success) { padding: 16px; border: 1px solid var(--accent); border-radius: 6px; color: var(--text); list-style: none; }
  .formkit-spinner { display: none; }
  .formkit-submit[data-active] .formkit-spinner { display: block; position: absolute; inset: 0; margin: auto; height: 18px; width: 18px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: spin .7s linear infinite; }
  .formkit-submit[data-active] > span { opacity: 0; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (max-width: 600px) {
    .newsletter-page { width: calc(100% - 40px); }
    header { padding-block: 20px; }
    main { padding-block: 20px; }
    h1 { font-size: clamp(2.25rem, 9vw, 3.3rem); margin-bottom: 18px; }
    .intro { font-size: .88rem; margin-bottom: 18px; }
    .topics { flex-direction: column; gap: 6px; margin-bottom: 22px; }
    .formkit-submit { padding-inline: 16px; }
    .formkit-submit > span > span { margin-left: 8px; }
    footer span:last-child { display: none; }
  }
  @media (max-height: 740px) {
    header { padding-block: 16px; }
    main { padding-block: 12px; }
    .eyebrow { margin-bottom: 12px; }
    h1 { font-size: clamp(2rem, 5vw, 3.3rem); margin-bottom: 14px; }
    .intro { line-height: 1.6; margin-bottom: 14px; }
    .topics { margin-bottom: 16px; }
    .signature { margin-top: 14px; }
    footer { padding-block: 12px; }
  }
  @media (max-height: 580px) and (min-width: 700px) {
    section { width: 100%; display: grid; grid-template-columns: 1fr 1fr; column-gap: 40px; align-items: center; }
    .eyebrow, h1, .intro, .topics { grid-column: 1; }
    .signup { grid-column: 2; grid-row: 2 / 5; }
    .signature { display: none; }
  }
</style>
