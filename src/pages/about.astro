---
import SiteLayout from '../layouts/SiteLayout.astro';
import { profile } from '../data/site';
import OptimizedImage from '../components/OptimizedImage.astro';
---
<SiteLayout title="About me" description="Meet Mishal Abdullah: software engineer, indie hacker, open-source contributor, and Beckn Kerala chapter lead.">
<section class="container page-heading"><p class="eyebrow">THE STORY SO FAR</p><h1>Curiosity made me do it<span class="accent">.</span></h1><p>A developer, a maker, and someone who likes figuring things out.</p></section>
<section class="container about-preview"><OptimizedImage src={profile.about.image} alt="Mishal Abdullah standing beneath the Google logo" width={800} loading="eager" /><div><h2>Hey, I’m Mishal.</h2><p>I’m a programmer with a passion for hacking things. I build highly niche tools and take on the projects that push me to learn something new.</p><p>My work spans AI products, backend systems, and open networks using the Beckn protocol. I care about useful software, open collaboration, and sharing what I learn.</p><h3>My toolkit</h3><div class="tags">{profile.about.skills.items.map((s: string) => <span>{s}</span>)}</div></div></section>
<section class="container section"><p class="eyebrow">THE WORK ALONG THE WAY</p><h2>Experience</h2><div class="timeline">{profile.experience.items.map((e: any) => <article><div><span class="meta">{e.date}</span><h3><a href={e.companyUrl}>{e.company} ↗</a></h3><p>{e.job}</p></div><div class="experience-body"><p>{e.content.replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')}</p>{e.featuredLink.enable && <a class="text-link" href={e.featuredLink.url}>View certificate ↗</a>}</div></article>)}</div></section>
<section class="container section"><p class="eyebrow">BETTER, TOGETHER</p><h2>Open source & community</h2><div class="resource-grid">{profile.opensource.items.map((p: any) => <a class="resource-card" href={p.url}><span class="meta">{p.role}</span><h3>{p.name} ↗</h3><p>{p.content}</p><div class="tags">{p.tags.map((t: string) => <span>{t}</span>)}</div></a>)}</div></section>
<section class="container section"><p class="eyebrow">MILESTONES</p><h2>A few proud moments</h2><div class="resource-grid">{profile.achievements.items.map((a: any) => <article class="resource-card"><h3>{a.title}</h3><p>{a.content}</p>{a.url && <a class="text-link" href={a.url}>See the story ↗</a>}</article>)}</div></section>
</SiteLayout>
