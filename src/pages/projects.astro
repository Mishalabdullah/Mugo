---
import SiteLayout from '../layouts/SiteLayout.astro';
import { profile } from '../data/site';
import OptimizedImage from '../components/OptimizedImage.astro';
---
<SiteLayout title="Projects" description="Explore Mishal Abdullah’s projects: Kryate, dressme.space, focusjournal, and the Beckn Onix GUI."><section class="container page-heading"><p class="eyebrow">BUILT WITH CURIOSITY</p><h1>Ideas, made real<span class="accent">.</span></h1><p>AI tools, small experiments, and open-source contributions.</p></section><section class="container project-grid section">{profile.projects.items.map((p: any) => <article class="project-card"><a class="project-image" href={p.featured.link}><OptimizedImage src={p.image} alt={`${p.title} application preview`} width={800} height={496} /></a><div class="project-details"><div><h2><a href={p.featured.link}>{p.title} ↗</a></h2><p>{p.content}</p><div class="tags">{p.badges.map((b: string) => <span>{b}</span>)}</div>{p.links?.map((l: any) => <a class="text-link" href={l.url}>Source code ↗</a>)}</div></div></article>)}</section></SiteLayout>
