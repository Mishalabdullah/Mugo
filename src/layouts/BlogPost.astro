---
import SiteLayout from './SiteLayout.astro';
import PostCard from '../components/PostCard.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import { socialImage } from '../lib/social-images';
import { type Post, description, dateLabel, readingTime, getPosts, postUrl } from '../lib/posts';
interface Props { post: Post; headings: { depth: number; slug: string; text: string }[]; }
const { post, headings } = Astro.props;
const related = (await getPosts()).filter(p => p.id !== post.id).sort((a,b) => Number(b.data.tags.some(t => post.data.tags.includes(t))) - Number(a.data.tags.some(t => post.data.tags.includes(t)))).slice(0, 3);
const schemaImage = await socialImage(post.data.title, post.data.image);
const schema = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.data.title, description: description(post), datePublished: post.data.date.toISOString(), dateModified: (post.data.updatedDate || post.data.date).toISOString(), image: new URL(schemaImage.src, Astro.site), author: { '@type': 'Person', name: 'Mishal Abdullah', url: new URL('/about/', Astro.site) }, mainEntityOfPage: new URL(postUrl(post), Astro.site), inLanguage: 'en-US', keywords: post.data.tags.join(', ') };
const breadcrumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site },
  { '@type': 'ListItem', position: 2, name: 'Articles', item: new URL('/blogs/', Astro.site) },
  { '@type': 'ListItem', position: 3, name: post.data.title, item: new URL(postUrl(post), Astro.site) },
] };
---
<SiteLayout title={post.data.title} description={description(post)} image={post.data.image} article date={post.data.date} updatedDate={post.data.updatedDate} canonical={postUrl(post)}>
<script slot="head" type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
<script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbs).replace(/</g, '\\u003c')} />
<div class="reading-progress" aria-hidden="true"></div><article class="container"><header class="article-heading"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true"> / </span><a href="/blogs/">Articles</a><span aria-hidden="true"> / </span><span aria-current="page">{post.data.title}</span></nav><div class="tags">{post.data.tags.map(t => <span>{t}</span>)}</div><h1>{post.data.title}</h1><p class="meta">By <a href="/about/" rel="author">Mishal Abdullah</a> · <time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time> · {readingTime(post)} min read</p>{post.data.updatedDate && <p class="meta">Updated {dateLabel(post.data.updatedDate)}</p>}</header>{post.data.image && <OptimizedImage class="article-cover" src={post.data.image} alt={`${post.data.title} — article cover`} width={1200} widths={[400, 800, 1200, 1600]} sizes="(max-width: 750px) calc(100vw - 40px), (max-width: 1260px) calc(100vw - 80px), 1180px" loading="eager" fetchpriority="high" />}<div class="article-layout"><aside class="toc"><p class="eyebrow">ON THIS PAGE</p><nav aria-label="Table of contents">{headings.filter(h => h.depth === 2 || h.depth === 3).map(h => <a href={`#${h.slug}`} class:list={{ indent: h.depth === 3 }}>{h.text}</a>)}</nav><a class="text-link" href="/rss.xml">Follow via RSS ↗</a></aside><div class="prose"><slot /><div class="author-note"><h3>Thanks for reading.</h3><p>I’m Mishal — a developer and indie hacker sharing what I learn. Have a thought on this? <a href="https://x.com/mishalabdula">Let’s talk on X.</a></p><button id="copy-link" type="button">Copy article link ↗</button><span id="copy-status" role="status"></span></div></div></div></article><section class="container section"><p class="eyebrow">KEEP EXPLORING</p><h2>You might also enjoy</h2><div class="post-grid">{related.map(p => <PostCard post={p} />)}</div></section>
</SiteLayout>
<script>
const bar = document.querySelector<HTMLElement>('.reading-progress')!;
const update = () => { const article = document.querySelector('.prose')!; const start = article.getBoundingClientRect().top + window.scrollY; const length = article.scrollHeight - window.innerHeight; bar.style.width = `${Math.max(0, Math.min(100, (window.scrollY - start) / Math.max(1, length) * 100))}%`; };
window.addEventListener('scroll', update, { passive: true }); window.addEventListener('resize', update); update();
document.querySelector('#copy-link')?.addEventListener('click', async () => { try { await navigator.clipboard.writeText(document.querySelector<HTMLLinkElement>('link[rel="canonical"]')!.href); document.querySelector('#copy-status')!.textContent = ' Link copied!'; } catch { document.querySelector('#copy-status')!.textContent = ' Copy the URL from your address bar.'; } });
</script>
